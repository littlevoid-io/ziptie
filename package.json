{
  "name": "@littlevoid/ziptie",
  "version": "1.3.0",
  "description": "Windows 11 kiosk and exhibit PC bootstrap utility.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlevoid-io/ziptie.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ziptie": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/assets.json",
    "ziptie.config.json",
    "ziptie.default.config.json",
    "ziptie.schema.json",
    "ziptie.animation.json",
    "scripts",
    "ziptie.bat",
    "setup.bat",
    "LICENSE",
    "README.md"
  ],
  "author": "littlevoid",
  "license": "MIT",
  "scripts": {
    "prepare": "node scripts/build-assets.js",
    "start": "node dist/index.js",
    "build": "node scripts/build-assets.js && bun build ./src/index.ts --target=node --outfile=dist/index.js",
    "package": "node scripts/build-assets.js && bun build --compile --target=node ./src/index.ts --outfile=dist/ziptie.exe && powershell -Command \"Compress-Archive -Path dist/ziptie.exe, scripts, ziptie.default.config.json, ziptie.schema.json, ziptie.animation.json, ziptie.bat, setup.bat -DestinationPath dist/ziptie.zip -Force\"",
    "sandbox": "npm run package && node test/launch-sandbox.js",
    "sandbox:local": "npm run package && node test/launch-sandbox.js --run-tests",
    "sandbox:remote": "node test/launch-sandbox-remote.js",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/build-assets.js && bun test test/cli.test.ts test/unit && bun run test:pester",
    "test:cli": "node scripts/build-assets.js && bun test test/cli.test.ts",
    "test:pester": "powershell -ExecutionPolicy Bypass -File test/run-tests.ps1",
    "test:pester5": "powershell -ExecutionPolicy Bypass -File test/run-pester5.ps1",
    "test:unit": "node scripts/build-assets.js && bun test test/unit"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "chalk": "^5.6.2",
    "deepmerge": "^4.3.1",
    "listr2": "^10.2.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.7",
    "typescript": "^5.0.0"
  }
}
